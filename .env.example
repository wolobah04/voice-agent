PORT=8080
PUBLIC_HOST=your-host.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
DEEPGRAM_API_KEY=
# Groq powers the LLM (openai/gpt-oss-120b). Get a key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# HuggingFace Inference API powers embeddings (BAAI/bge-small-en-v1.5, 384 dims)
# Get a token at https://huggingface.co/settings/tokens (read scope is enough)
HUGGINGFACE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# IMPORTANT: point at the SAME Supabase project the Lovable web app uses
# (find these in Lovable Cloud -> Backend -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HUMAN_HANDOFF_NUMBER=+231770000000
